# Hosted Demo profile. It serves built frontend assets but keeps all writes in
# the synthetic in-memory upstream client.

DEMO_MODE=true
NODE_ENV=production
TRUST_PROXY=false
SERVE_FRONTEND_FROM_BACKEND=true
FRONTEND_STATIC_DIR=../frontend/dist
RAGIC_WRITE_TARGET=test
NOTICE_TOKEN_TTL_MINUTES=10080
