# Production profile overrides for Windows server deployment.
# Copy backend/.env.example to backend/.env first, fill secrets/form IDs there,
# then make sure these values are set for the production server.

NODE_ENV=production
TRUST_PROXY=false
SERVE_FRONTEND_FROM_BACKEND=true
FRONTEND_STATIC_DIR=D:\sites\report
RAGIC_WRITE_TARGET=prod
NOTICE_TOKEN_TTL_MINUTES=10080
