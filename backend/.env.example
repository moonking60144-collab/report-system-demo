# Server
# production/default backend port；本機完整 UI 測試腳本會 shell-level 覆寫為 3300
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
SERVE_FRONTEND_FROM_BACKEND=false
FRONTEND_STATIC_DIR=

# Ragic connection
RAGIC_PROTOCOL=https
RAGIC_DOMAIN=demo.local
# Ragic Builder 安裝目錄的 cust/def/app 根（backend 與 Ragic 同台才有效；目錄不存在=停用 workflow 直讀掃描）
RAGIC_BUILDER_PATH=
RAGIC_API_KEY=
# 測試用 service account key（compare-api-keys.ts / USE_TEST_API_KEY 用）
TEST_API_KEY=
# true 時 backend 整套改用 TEST_API_KEY 跑（測 service account 權限是否齊全），
# 完成後務必改回 false。啟動時若為 true 會 console.warn 提醒。
USE_TEST_API_KEY=false
# Admin tool 專用 key（dev mode「重新抓取」走 /sims/doc.jsp 這類 admin-only
# endpoint 用）。Service account 沒這層權限，必須留個人帳號 key 給這類操作。
# 空值時 fallback 到 RAGIC_API_KEY（向後相容）。
ADMIN_API_KEY=
# dev mode 欄位索引 refresh 是否啟用 content hash skip。
# 預設 true：抓回 doc.jsp HTML 後算 sha1，跟上次成功 refresh 的 hash 比對命中
# → 跳過 parse + replaceAll 的 25~30s。設 false 是 escape hatch（debug / 強制重抓）。
RAGIC_FIELD_INDEX_HASH_SKIP=true
# dev mode 欄位索引背景自動 refresh：每 N 分鐘抓 doc.jsp 重建索引，讓開 dev modal
# 永遠讀最近一次背景更新的本機 SQLite（<100ms），不用開 modal 才等。
# ENABLED=false 回到純手動「重新抓取」；INTERVAL 預設 30min（下限 60s）；
# STARTUP_DELAY 啟動後延遲首次避開尖峰。
RAGIC_FIELD_INDEX_AUTO_REFRESH_ENABLED=true
RAGIC_FIELD_INDEX_AUTO_REFRESH_INTERVAL_MS=7200000
RAGIC_FIELD_INDEX_AUTO_REFRESH_STARTUP_DELAY_MS=60000

# Main form (Phase 1)
RAGIC_FORM_104_PATH=/default/forms8/104
RAGIC_FORM_104_TEST_PATH=
RAGIC_FORM_104_CLOSE_ACTION_BUTTON_ID=13
RAGIC_FORM_104_REOPEN_ACTION_BUTTON_ID=18
# Heading report form（目前 create/update 流程已收斂成只打 /c1/16 的 48）
RAGIC_FORM_105_PATH=/default/forms8/105
RAGIC_FORM_105_TEST_PATH=
RAGIC_FORM_105_CLOSE_ACTION_BUTTON_ID=13
RAGIC_FORM_105_REOPEN_ACTION_BUTTON_ID=18
RAGIC_FORM_16_PATH=/default/c1/16
RAGIC_FORM_16_TEST_PATH=
RAGIC_FORM_16_SAVE_ACTION_BUTTON_ID=48
RAGIC_FORM_16_WORK_ORDER_FIELD_ID=1006365
RAGIC_FORM_16_TYPE_FIELD_ID=1012669
RAGIC_FORM_16_PROCESS_FIELD_ID=1002195
RAGIC_FORM_16_DEP_FIELD_ID=1002221
RAGIC_FORM_16_PROD_TYPE_FIELD_ID=1002191
RAGIC_FORM_16_REMARK_FIELD_ID=1002177
RAGIC_FORM_16_DATE_FIELD_ID=1002190

# 稼動表 Excel 匯出：貼 Ragic「發佈到網路」做好的完整下載網址（含 APIKey + view）。
# 後端當 proxy 直接抓這條原樣轉發，key 藏後端、同事按鈕不必看到。建議用 .csv 結尾（稼動表從文字檔吃 CSV）。
# 例：https://demo.local/default/c1/6.csv?APIKey=xxxx&view=122
REPORT_EXCEL_CSV=
REPORT_EXCEL_CSV_TIMEOUT_MS=120000
# 效率報表歷史封存：開發可用相對路徑；正式 Server 請改成部署目錄外的持久化絕對路徑
EFFICIENCY_REPORT_DB_FILE=./.data/efficiency-reports/metadata.v1.sqlite3
EFFICIENCY_REPORT_ARCHIVE_DIR=./.data/efficiency-reports/files
EFFICIENCY_REPORT_MAX_SOURCE_BYTES=52428800
EFFICIENCY_REPORT_MAX_SOURCE_ROWS=200000
EFFICIENCY_REPORT_RETENTION_MONTHS=24
EFFICIENCY_REPORT_CLEANUP_ENABLED=true
EFFICIENCY_REPORT_CLEANUP_DRY_RUN=false
EFFICIENCY_REPORT_CLEANUP_STARTUP_DELAY_MS=300000
EFFICIENCY_REPORT_CLEANUP_INTERVAL_MS=86400000
# archive 備份 script 專用；備份根目錄不可放在 EFFICIENCY_REPORT_ARCHIVE_DIR 裡
EFFICIENCY_REPORT_BACKUP_DIR=./.data/backups/efficiency-reports
EFFICIENCY_REPORT_BACKUP_KEEP=7

# 會議錄音正式 staging。Windows production 請使用 Server 本機持久化絕對路徑；NAS archive 另由後續流程處理。
MEETING_RECORDING_STORAGE_DIR=./.data/meeting-recordings
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 必須固定保存；更換後既有瀏覽器會失去原本錄音的 owner 憑證。
MEETING_RECORDING_OWNER_COOKIE_SECRET=
# 錄音庫 Code HMAC pepper；至少 32 bytes。空白時不影響 owner 錄音，但停用跨裝置錄音庫存取。
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEETING_LIBRARY_CODE_PEPPER=
# 預設總上限 100 GiB；這是硬上限，容量不足時回 507，不會自動刪除任何已完成錄音。
MEETING_RECORDING_MAX_TOTAL_BYTES=107374182400
MEETING_RECORDING_MAX_SESSION_BYTES=5368709120
MEETING_RECORDING_MAX_CHUNK_BYTES=8388608
MEETING_RECORDING_STALE_SESSION_MS=172800000
MEETING_RECORDING_CLEANUP_ENABLED=true
MEETING_RECORDING_CLEANUP_STARTUP_DELAY_MS=600000
MEETING_RECORDING_CLEANUP_INTERVAL_MS=3600000

# Meeting 錄音後處理（獨立 SQLite + worker；正式環境請使用 Server 本機持久化絕對路徑）
MEETING_PROCESSING_DB_FILE=./.data/meeting-processing/metadata.v1.sqlite3
MEETING_PROCESSING_DIR=./.data/meeting-processing/artifacts
MEETING_WORKER_ENABLED=false
MEETING_WORKER_POLL_INTERVAL_MS=2000
MEETING_WORKER_RESTART_DELAY_MS=5000
MEETING_PROCESSING_MAX_ATTEMPTS=3
MEETING_PROCESSING_RETRY_DELAY_MS=60000
# 後處理 WAV/M4A 獨立上限 100 GiB；超過時只淘汰最舊且可重建的 processing audio，逐字稿與會議紀錄版本會保留。
MEETING_PROCESSING_MAX_TOTAL_BYTES=107374182400
MEETING_PROCESSING_CLEANUP_INTERVAL_MS=3600000
MEETING_PROCESSING_STALE_MS=1800000
MEETING_PROCESS_TIMEOUT_MS=7200000
MEETING_FFMPEG_PATH=
MEETING_FFPROBE_PATH=

# 預設禁止 Meeting 使用 Dev AI 的 Gemini credential；確定接受共用 quota/rotation 時才改成 true。
MEETING_ALLOW_SHARED_GEMINI_CREDENTIAL=false

# Meeting 逐字稿使用公司自架的開源 Whisper service；尚未部署時保持 disabled。
MEETING_TRANSCRIPTION_PROVIDER=disabled
# 必須填完整的 HTTP(S) transcription endpoint，不是只有 host。
MEETING_TRANSCRIPTION_LOCAL_URL=http://127.0.0.1:8010/v1/transcriptions
# 若 STT service 綁定非 loopback 介面，Node 與 Python 兩端必須設定相同 token。
MEETING_TRANSCRIPTION_LOCAL_TOKEN=
# 必須與 STT service 的 MEETING_STT_MODEL 完全一致。
MEETING_TRANSCRIPTION_LOCAL_MODEL=large-v3
# 逗號分隔，提供工令前綴、料號、製程、機台、人名等台灣工廠專有詞；最多取前 500 筆。
MEETING_TRANSCRIPTION_PHRASES=
MEETING_TRANSCRIPTION_LANGUAGE=zh-TW
# 每段 10 分鐘，允許範圍 1～30 分鐘；成功段落會 checkpoint，重試不重送。
MEETING_TRANSCRIPTION_CHUNK_MS=600000
MEETING_TRANSCRIPTION_MAX_ATTEMPTS=3
MEETING_TRANSCRIPTION_RETRY_DELAY_MS=60000
MEETING_TRANSCRIPTION_REQUEST_TIMEOUT_MS=1800000
# AI provider/model 切換後保留 7 天人工升級重送窗口；到期後 processing artifact 可回收。
MEETING_AI_PROVIDER_MIGRATION_RETRY_GRACE_MS=604800000

# MiniMax 是 Meeting Minutes 與 Dev AI 共用的正式文字生成 provider。
MINIMAX_API_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_API_KEY=
# Dev AI 與 Meeting Minutes 都依賴強制 tool_use；官方 Anthropic endpoint 啟動時只接受目前實測通過的模型。
MINIMAX_MODEL=MiniMax-M2.7
# backend API 與 meeting worker 是不同 process；各 process 最多 1 筆，合計不超過 Starter 的 2 路。
MINIMAX_REQUEST_CONCURRENCY=1
MINIMAX_QUEUE_TIMEOUT_MS=120000

# Meeting AI 會議紀錄。正式使用 minimax；Demo 才明確切換 google-gemini。
# 不會在單次請求失敗時自動跨供應商 fallback。
MEETING_MINUTES_PROVIDER=disabled
MEETING_MINUTES_MINIMAX_MAX_OUTPUT_TOKENS=16384
MEETING_MINUTES_GOOGLE_API_KEY=
MEETING_MINUTES_GOOGLE_MODEL=gemini-3.5-flash
MEETING_MINUTES_MAX_INPUT_CHARACTERS=500000
MEETING_MINUTES_MAX_ATTEMPTS=3
MEETING_MINUTES_RETRY_DELAY_MS=60000
MEETING_MINUTES_REQUEST_TIMEOUT_MS=1800000
RAGIC_ACTION_BUTTON_TIMEOUT_MS=30000
RAGIC_WRITE_TARGET=test

# Linked source forms
RAGIC_SOURCE_MACHINE=/default/forms51/1
RAGIC_SOURCE_OPERATOR=/default/forms11/13
RAGIC_SOURCE_PROCESS=/default/forms51/3
RAGIC_CALLBACK_TOKEN=
RAGIC_CALLBACK_DELAY_MS=1000
RAGIC_CALLBACK_TASK_PERSIST_ENABLED=true
RAGIC_CALLBACK_TASK_STORE_FILE=./.cache/ragic-callback-tasks.v1.json

# Cache
CACHE_TTL=300
CACHE_CHECK_PERIOD=60
SQLITE_ENABLED=true
# 讀取是否優先走 SQLite（失敗會回退 Ragic）
SQLITE_READ_ENABLED=true
# 104/105 都走 SQLite read（沒 snapshot 會自動回退 Ragic，零風險）
SQLITE_READ_FORMS=104,105
# snapshot 超過此毫秒數沒更新（全量 sync / callback 都會推進）視為過舊，
# 回退 Ragic 直讀並 log 告警，避免背景同步默默掛掉後一直端舊資料。0=停用檢查
SQLITE_READ_MAX_STALENESS_MS=7200000
SQLITE_DB_FILE=./.cache/work-report-read-model.v1.sqlite3
SQLITE_SYNC_BATCH_SIZE=500
# server 可選：定時背景同步 SQLite（預設關閉）
SQLITE_AUTO_SYNC_ENABLED=false
# 留空時預設跟 SQLITE_READ_FORMS 一致
SQLITE_AUTO_SYNC_FORMS=
# 預設 30 分鐘
SQLITE_AUTO_SYNC_INTERVAL_MS=1800000
# backend 啟動後延遲多久再跑第一輪 auto sync
SQLITE_AUTO_SYNC_STARTUP_DELAY_MS=30000
FORM16_SQLITE_AUTO_SYNC_ENABLED=true
FORM16_SQLITE_REFRESH_INTERVAL_MS=60000
# 計畫停機統計 SQLite 同步：背景定時撈近半年 (P)計畫停機分進 SQLite，讓圖表查 SQLite 秒回
FORM16_PLANNED_IDLE_SYNC_ENABLED=true
FORM16_PLANNED_IDLE_SYNC_INTERVAL_MS=1800000
FORM16_PLANNED_IDLE_SYNC_STARTUP_DELAY_MS=20000
OPERATOR_OPTION_CACHE_TTL_MS=60000
RAGIC_READ_CONCURRENCY=12
RAGIC_MUTATION_READ_CONCURRENCY=4
RAGIC_SYNC_READ_CONCURRENCY=4
RAGIC_BACKGROUND_READ_CONCURRENCY=4
# 舊版總預算設定；未設定 foreground/background 時會用這組切成前景 75%、背景 25%
RAGIC_GLOBAL_RATE_PER_SECOND=8
RAGIC_GLOBAL_BURST_CAPACITY=12
# 前景：user reads + writes。保留給互動操作，避免背景同步吃光 token。
RAGIC_FOREGROUND_RATE_PER_SECOND=6
RAGIC_FOREGROUND_BURST_CAPACITY=9
# Mutation read：寫入前 live precondition / stale check，和一般 user refresh 分開。
RAGIC_MUTATION_RATE_PER_SECOND=3
RAGIC_MUTATION_BURST_CAPACITY=4
# 背景：full sync / field-index / callback projection / planned-idle sync。
RAGIC_BACKGROUND_RATE_PER_SECOND=2
RAGIC_BACKGROUND_BURST_CAPACITY=3
RAGIC_QUEUE_TIMEOUT_MS=30000
RAGIC_READ_TIMEOUT_MS=15000
RAGIC_MUTATION_READ_TIMEOUT_MS=10000
RAGIC_MUTATION_READ_MAX_RETRIES=1
RAGIC_SYNC_READ_TIMEOUT_MS=60000
RAGIC_BACKGROUND_READ_TIMEOUT_MS=30000
RAGIC_WRITE_TIMEOUT_MS=30000
# Form16 寫入後驗證 timeout。work-report create 的讀取錯誤只記狀態未知並放行；
# 讀回後欄位 mismatch 仍會 rollback + throw。
FORM16_WRITE_VERIFY_TIMEOUT_MS=10000
FORM16_WRITE_VERIFY_MAX_RETRIES=0
# 讀回驗證 timeout/讀取錯誤時排入後續補驗，避免「慢但已寫入」變成使用者假失敗。
FORM16_WRITE_REVERIFY_ENABLED=true
FORM16_WRITE_REVERIFY_STORE_FILE=./.data/form16-write-reverify.v1.json
FORM16_WRITE_REVERIFY_INTERVAL_MS=60000
FORM16_WRITE_REVERIFY_STARTUP_DELAY_MS=30000
FORM16_WRITE_REVERIFY_MAX_PER_RUN=20
FORM16_WRITE_REVERIFY_MAX_ATTEMPTS=6
FORM16_WRITE_REVERIFY_TIMEOUT_MS=30000
FORM16_WRITE_REVERIFY_MAX_RETRIES=1
RAGIC_WRITE_CONCURRENCY=2
RAGIC_GET_RETRY_MAX=2
RAGIC_GET_RETRY_BASE_DELAY_MS=200
RAGIC_WRITE_RETRY_MAX=1
RAGIC_WRITE_RETRY_BASE_DELAY_MS=300
RAGIC_METRICS_WINDOW_SIZE=200
# Ragic 側連續失敗時開 circuit breaker（連續 N 筆失敗就停 M 毫秒不再打）
RAGIC_CIRCUIT_FAILURE_THRESHOLD=10
RAGIC_CIRCUIT_COOLDOWN_MS=30000
# 正式環境預設啟用；記錄 event loop、記憶體、mutation queue 與 Meeting backlog。
RUNTIME_HEALTH_LOG_ENABLED=true
RUNTIME_HEALTH_LOG_INTERVAL_MS=60000
RUNTIME_HEALTH_EVENT_LOOP_P95_WARN_MS=100
RUNTIME_HEALTH_MEETING_PENDING_WARN_MS=1800000
# /dev/definitions 跨版本公式查詢慢查紀錄門檻；0=全部記錄
RAGIC_FORMULA_SIBLINGS_SLOW_LOG_THRESHOLD_MS=1000
REPORT_FULL_CACHE_ENABLED=true
REPORT_FULL_CACHE_TTL_MS=604800000
REPORT_FULL_CACHE_FILE=./.cache/reports-104-full.v1.json
REPORT_FULL_CACHE_STALE_WHILE_REVALIDATE=true
# 啟動後非阻塞預熱 /reports/full 快取（預設開啟）
REPORT_FULL_CACHE_PREWARM_ON_START=true
REPORT_FULL_CACHE_MAX_RECORDS=20000

# Create report performance tuning
CREATE_POLL_MAX_RETRY=3
CREATE_POLL_DELAY_MS=200
CREATE_SLOW_LOG_THRESHOLD_MS=3000
# 上線建議維持 false，避免 create 流程印出大量 debug 細節
CREATE_DEBUG_OPERATOR=false
CREATE_DEBUG_OPERATOR_KEY_LIMIT=30
CREATE_RECALC_ACTION_RETRY=1
CREATE_RECALC_VERIFY_RETRY=2
CREATE_RECALC_VERIFY_DELAY_MS=400
CREATE_RECALC_STRICT=false
CREATE_TASK_PERSIST_ENABLED=true
CREATE_TASK_STORE_FILE=./.cache/create-report-tasks.v1.json
CREATE_TASK_HISTORY_LIMIT=2000
WORK_REPORT_MUTATION_MAX_PENDING_TOTAL=500
WORK_REPORT_MUTATION_MAX_PENDING_PER_KEY=25
WORK_REPORT_MUTATION_MAX_QUEUE_AGE_MS=600000
WORK_REPORT_BATCH_DELETE_CONCURRENCY=3
WORK_REPORT_BATCH_CREATE_FINALIZE_RETRY=3
WORK_REPORT_BATCH_CREATE_FINALIZE_RETRY_DELAY_MS=1500
WORK_REPORT_TASK_REGISTRY_PERSIST_ENABLED=true
WORK_REPORT_TASK_REGISTRY_STORE_FILE=./.cache/work-report-task-registry.v1.json
WORK_REPORT_TASK_REGISTRY_HISTORY_LIMIT=5000

# Dev AI formula assistant（只產生公式草案 + dry-run，不直接 apply）
# 公司正式環境使用 minimax；面試 Demo 可明確切換 google-gemini 免費層。
# 舊值 google 仍相容；provider 不會在單次請求失敗時自動跨供應商 fallback。
DEV_AI_ENABLED=false
DEV_AI_PROVIDER=minimax
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GEMINI_FAST_MODEL=
GOOGLE_GEMINI_THINKING_LEVEL=minimal
GOOGLE_GEMINI_STORE_INTERACTIONS=false
DEV_AI_MAX_CONTEXT_CHARS=24000
DEV_AI_CHAT_MAX_CONTEXT_CHARS=16000
DEV_AI_MAX_OUTPUT_TOKENS=2048
DEV_AI_CHAT_MAX_OUTPUT_TOKENS=1024
DEV_AI_REQUEST_TIMEOUT_MS=30000
DEV_AI_MAX_CONCURRENT_REQUESTS=2
DEV_AI_SUGGEST_RATE_LIMIT_PER_MINUTE=6
DEV_AI_KNOWLEDGE_DIR=./.data/dev-ai/knowledge
DEV_AI_KNOWLEDGE_MAX_ITEMS=8
DEV_AI_KNOWLEDGE_CACHE_TTL_MS=15000
DEV_AI_APPROVED_EXAMPLES_FILE=./.data/dev-ai/knowledge/approved-examples.jsonl
DEV_AI_COMPILED_KNOWLEDGE_DIR=./.data/dev-ai/knowledge/compiled
DEV_AI_CONVERSATION_HISTORY_ENABLED=false
DEV_AI_CONVERSATION_DB_FILE=./.data/dev-ai/conversations.v1.sqlite3
DEV_AI_THREAD_CONTEXT_MESSAGES=12
DEV_AI_THREAD_LIST_LIMIT=50
DEV_AI_THREAD_DETAIL_MESSAGE_LIMIT=200
DEV_AI_THREAD_DETAIL_ARTIFACT_LIMIT=100
DEV_AI_MAX_THREADS_PER_ACTOR=200
DEV_AI_MAX_MESSAGES_PER_THREAD=300
DEV_AI_MAX_ARTIFACTS_PER_THREAD=150
DEV_AI_THREAD_RETENTION_DAYS=180
DEV_AI_ARCHIVED_THREAD_RETENTION_DAYS=30
DEV_AI_THREAD_SUMMARY_ENABLED=true
DEV_AI_THREAD_SUMMARY_AFTER_MESSAGES=2
DEV_AI_STORE_RAW_OUTPUT=false

# Form 16 孤兒背景清理（2A/2B/2C 的兜底）
# 預設關閉；確認 idempotency + verify + rollback 上線穩定後再打開。
# 每 10 分鐘掃、createdAt > 10 分鐘才刪、單次最多 50 筆、範圍最近 90 天。
# 判定條件：workOrderNo 空 + 計畫停機!=Yes + 報工類別在白名單 + 開單者符合 + ERP料號不含 test
# CLEANUP_ENABLED=true 時 CREATOR_ACCOUNT 必填（用來把誤刪風險鎖在「系統 API 寫的」那批）；
# 空值時 bootstrap 會拒絕啟動
FORM16_ORPHAN_CLEANUP_ENABLED=false
FORM16_ORPHAN_CREATOR_ACCOUNT=

# System notice (single file + admin login)
SYSTEM_NOTICE_FILE=./.data/system-notice.v1.json
NOTICE_ADMIN_USERNAME=admin
# 使用 SHA-256 雜湊值（例如 echo -n "your-password" | sha256sum）
NOTICE_ADMIN_PASSWORD_HASH=
NOTICE_TOKEN_TTL_MINUTES=10080
NOTICE_LOGIN_MAX_FAILURES=8
NOTICE_LOGIN_WINDOW_MS=900000
NOTICE_LOGIN_LOCK_MS=900000

# Definitions export / apply 跨行程寫入鎖；空值時預設 backend/.data/ragic-definitions.write.lock
# RAGIC_DEFINITIONS_LOCK_FILE=./.data/ragic-definitions.write.lock
# Java 正規化／RAG ingestion 專用唯讀 API token；至少 32 字元。
# 未設定或不足 32 字元時 /api/integrations/ragic-definitions/* fail-closed 回 503。
RAGIC_DEFINITIONS_SOURCE_API_TOKEN=
# 壓縮快照保留 revision 數量；預設 10，上限 100。
RAGIC_DEFINITIONS_SNAPSHOT_RETAIN_COUNT=10
# definitions 匯出在獨立子程序執行的最長時間。
RAGIC_DEFINITIONS_EXPORT_TIMEOUT_MS=600000

# CORS
# CORS_ORIGIN 支援逗號分隔多個 origin；或用 CORS_ORIGINS（同義，優先判讀）
# 開發用
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# 正式環境範例（上線時改成你的 HTTPS 網域）
# CORS_ORIGIN=https://demo.example.com
# 多 origin 範例：CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
