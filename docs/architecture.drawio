        <mxCell id="title" value="工廠營運平台 Demo｜完整系統架構" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="900" height="42" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="公開版保留正式服務邊界、背景任務與資料一致性機制；外部 SaaS、AI 與 STT 以合成 fixture 或可選 provider 取代。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#526077;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1500" height="30" as="geometry" /></mxCell>

