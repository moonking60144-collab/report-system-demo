# API base URL for frontend
VITE_API_BASE_URL=http://localhost:3000/api
# 系統通知版本輪詢間隔（毫秒）
VITE_SYSTEM_NOTICE_POLL_INTERVAL_MS=15000
# Work Report 104/105 optimistic overlay；設為 false 可保留 task/retry metadata 並停用即時畫面覆蓋
VITE_WORK_REPORT_OPTIMISTIC_MUTATIONS_ENABLED=true
# Form 16 optimistic overlay 與 async update/delete consumer；設為 false 會切回既有同步 update/delete route
VITE_FORM16_OPTIMISTIC_MUTATIONS_ENABLED=true
