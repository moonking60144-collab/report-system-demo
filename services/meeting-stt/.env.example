MEETING_STT_HOST=127.0.0.1
MEETING_STT_PORT=8010
# 綁定 0.0.0.0 或跨主機時必填，並與 Node 的 MEETING_TRANSCRIPTION_LOCAL_TOKEN 相同。
MEETING_STT_API_TOKEN=
MEETING_STT_MODEL=large-v3
MEETING_STT_DEVICE=auto
MEETING_STT_COMPUTE_TYPE=default
MEETING_STT_MODEL_CACHE_DIR=./.model-cache
MEETING_STT_CPU_THREADS=4
MEETING_STT_MAX_CONCURRENCY=1
MEETING_STT_QUEUE_TIMEOUT_SECONDS=5
MEETING_STT_MAX_UPLOAD_BYTES=67108864
MEETING_STT_OPENCC_CONFIG=s2twp
# 預設不啟用 pyannote；Node 的 room-mic/remote-tab 雙音軌來源仍會保留。
MEETING_STT_DIARIZATION_ENABLED=false
MEETING_STT_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
